# 本文件为「将来在根目录执行 git init」兜底。
# 目前根目录不是 git 仓库(只有 GovAi/govai-enterprise 和 Supervision 两个子仓库,
# 它们各自有自己的 .gitignore)。若不预先排除,根目录的运行产物会一起进版本库。

# ===== 本仓库整理出的运行产物目录 =====
logs/
backups/
archive/
文档/文档提取产物/

# ===== Java / Maven =====
target/
*.class
*.jar
!.mvn/wrapper/*.jar

# ===== Node =====
node_modules/
dist/
unpackage/
.hbuilderx/
.vite/

# ===== IDE =====
.idea/
*.iml
.vscode/
.settings/

# ===== 运行期日志与上传 =====
*.log
logs-*.txt
uploads/
upload/
.shots/

# ===== Python =====
__pycache__/
*.pyc

# ===== OS =====
.DS_Store
Thumbs.db

# ===== 体积大 / 交付物(不进仓库) =====
交付包-第12组/
文档/
.git.bak/

# ===== 重复 / 备份目录 =====
govai-citizen-ui-backup/
govai-citizen-ui-hx/
